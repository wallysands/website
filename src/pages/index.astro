---
import BaseLayout from "../layouts/BaseLayout.astro";
import FeatureCard from "../components/FeatureCard.astro";
---

<BaseLayout>
  <section class="hero">
    <p class="eyebrow">Portfolio</p>
    <h1>Computer science, visualization, and observational art.</h1>
    <p>
      Walter Sands is a computer science PhD student at the University of Minnesota working across mixed reality,
      scientific visualization, and software and data systems. This site gathers research, industry experience, artwork,
      and projects in one place.
    </p>
  </section>

  <section class="grid" aria-label="Portfolio sections">
    <FeatureCard
      title="Experience"
      href="/experience/"
      meta="Research and practice"
      summary="PhD research, education, and industry roles in software and data systems."
      image={{ src: "/publications/drawing-in-the-flow-teaser.png" }}
    />
    <FeatureCard
      title="Art"
      href="/art/"
      meta="Observational studies"
      summary="Still life, outdoor, figure, and digital studies from observation and imagination."
      images={[
        { src: "/art/stilllife/desk.png" },
        { src: "/art/outdoor/path.jpg" },
        { src: "/art/figures/selfportait.jpg" },
      ]}
    />
    <FeatureCard
      title="Projects"
      href="/projects/"
      meta="Selected work"
      summary="Graphics, interaction, visualization, and graph search project writeups."
      image={{ src: "/projects/tournament-searcher/graph-20.jpg" }}
    />
  </section>

  <section class="section current-focus">
    <h2>Current Focus</h2>
    <p>
      Research in the Interactive Visualization Lab explores mixed reality interfaces for scientific visualization,
      including sketch-based interaction inside a VR headset for authoring 3D flow visualizations. Current PhD work
      extends that interest into collaboration, with systems where a VR headset user can work alongside a robot in the
      same room.
    </p>
  </section>
</BaseLayout>

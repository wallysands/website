---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import GallerySection from "../components/GallerySection.astro";

const artEntries = await getCollection("art");
const byOrder = (a: CollectionEntry<"art">, b: CollectionEntry<"art">) =>
  (a.data.order ?? 999) - (b.data.order ?? 999) || a.data.title.localeCompare(b.data.title);
const stillLifes = artEntries.filter((entry) => entry.data.category === "still-life").sort(byOrder);
const pleinAir = artEntries.filter((entry) => entry.data.category === "outdoor-plein-air").sort(byOrder);
const random = artEntries.filter((entry) => entry.data.category === "random").sort(byOrder);
const figures = artEntries.filter((entry) => entry.data.category === "figures").sort(byOrder);
---

<BaseLayout title="Art | Walter Sands">
  <PageHeader
    eyebrow="Art"
    title="Art studies from observation and imagination."
    intro="Charcoal, graphite pencil, and 3D digital studies from observation, reference, and imagination."
  />
  <nav class="section-jump-nav" aria-label="Art sections">
    <a href="#still-lifes">Still Lifes</a>
    <a href="#outdoor-plein-air">Outdoor / Plein Air</a>
    <a href="#digital-studies">Miscellaneous</a>
    <a href="#figures">Figures</a>
  </nav>
  <GallerySection title="Still Lifes" summary="Still life studies built around close looking, arrangement, and light." entries={stillLifes} />
  <GallerySection title="Outdoor / Plein Air" summary="Outdoor work made from direct observation of landscape, weather, and place." entries={pleinAir} />
  <GallerySection title="Miscellaneous" summary="Digital scene experiments and loose visual studies." entries={random} />
  <GallerySection title="Figures" summary="Graphite studies of faces, figures, and character references." entries={figures} />
</BaseLayout>

---
import { withBase } from "../lib/urls";

interface GalleryEntry {
  id: string;
  data: {
    title: string;
    year?: number;
    medium?: string;
    image?: string;
    fullImage?: string;
    video?: string;
    status: string;
    category: string;
    description?: string;
  };
}

interface Props {
  title: string;
  summary: string;
  entries: GalleryEntry[];
}

const { title, summary, entries } = Astro.props;
const sectionId = title.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
---

<section id={sectionId} class="section gallery-section">
  <div class="section-heading">
    <h2>{title}</h2>
    <p>{summary}</p>
  </div>
  <div class="gallery-masonry">
    {
      entries.map((entry) => {
        const image = entry.data.image ? withBase(entry.data.image) : "";
        const fullImage = entry.data.fullImage ? withBase(entry.data.fullImage) : image;
        const video = entry.data.video ? withBase(entry.data.video) : "";
        const detailId = `art-${entry.id.replace(/[^a-z0-9-]/gi, "-")}`;
        const meta = [entry.data.year, entry.data.medium].filter(Boolean).join(" · ");
        const alt = [entry.data.title, entry.data.year, entry.data.medium].filter(Boolean).join(", ");
        const hasMedia = entry.data.status === "available" && (entry.data.image || entry.data.video);

        return (
          <article class="gallery-item">
            {hasMedia ? (
              <>
                <a class="art-image-link" href={`#${detailId}`} aria-label={`View ${entry.data.title} larger`}>
                  {video ? (
                    <video class="art-image" autoplay muted loop playsinline preload="metadata" poster={image || undefined} aria-label={alt}>
                      <source src={video} type="video/mp4" />
                    </video>
                  ) : (
                    <img class="art-image" src={image} alt={alt} loading="lazy" />
                  )}
                </a>
                <div id={detailId} class="art-lightbox" aria-label={entry.data.title}>
                  <a class="art-lightbox-backdrop" href={`#${sectionId}`} aria-label="Close enlarged artwork"></a>
                  <figure>
                    {video ? (
                      <video controls playsinline poster={fullImage || image || undefined} aria-label={alt}>
                        <source src={video} type="video/mp4" />
                      </video>
                    ) : (
                      <img src={fullImage} alt={alt} />
                    )}
                    <figcaption>
                      <strong>{entry.data.title}</strong>
                      {meta && <span>{meta}</span>}
                    </figcaption>
                    <a class="art-lightbox-close" href={`#${sectionId}`} aria-label="Close enlarged artwork">Close</a>
                  </figure>
                </div>
              </>
            ) : (
              <div class="art-frame" aria-hidden="true"></div>
            )}
            <div class="gallery-caption">
              <h3>{entry.data.title}</h3>
              <p>{entry.data.description}</p>
              <span>{entry.data.status === "planned" ? "Images to be added" : meta}</span>
            </div>
          </article>
        );
      })
    }
  </div>
</section>
